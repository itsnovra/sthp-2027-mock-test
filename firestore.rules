rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'aliza786hulio@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Candidate User Profiles (Contains PII - Restricted Access)
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && incoming().fullName is string && incoming().fullName.size() <= 100
        && incoming().rollNumber is string && incoming().rollNumber.size() <= 30;
      allow update: if (isSignedIn() && (request.auth.uid == userId || isAdmin()))
        || (isValidId(userId) && incoming().fullName is string);
      allow delete: if isAdmin();
    }

    // Exam Submissions (Individual Attempt Details)
    match /submissions/{submissionId} {
      allow get: if isValidId(submissionId);
      allow list: if isAdmin();
      allow create: if isValidId(submissionId)
        && incoming().score is number
        && incoming().percentage is number
        && incoming().studentName is string && incoming().studentName.size() <= 100;
      allow update, delete: if isAdmin();
    }

    // Public Sanitized Global Leaderboard (No PII)
    match /leaderboard/{submissionId} {
      allow read: if true;
      allow create: if isValidId(submissionId)
        && incoming().score is number
        && incoming().percentage is number
        && incoming().studentName is string && incoming().studentName.size() <= 100;
      allow update, delete: if isAdmin();
    }

    // Test Configurations
    match /tests/{testId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin Authority List
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
